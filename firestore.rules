rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Devices collection
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Maintenance collections
    match /inspections/{docId} {
      allow read, write: if true;
    }
    match /replacements/{docId} {
      allow read, write: if true;
    }
    match /incidents/{docId} {
      allow read, write: if true;
    }
    match /transfers/{docId} {
      allow read, write: if true;
    }
    match /inventories/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isAdmin() || request.auth.uid == userId;
    }
  }
}
