{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "technician", "staff"] },
        "department": { "type": "string" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "department"]
    },
    "Device": {
      "title": "Device",
      "description": "Hardware device",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serialNumber": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "warrantyUntil": { "type": "string" },
        "supplier": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "serialNumber", "name", "category", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/devices/{deviceId}": {
      "schema": { "$ref": "Device" },
      "description": "Device inventory"
    }
  }
}
